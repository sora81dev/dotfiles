{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/logout", 
    "custom/shutdown", 
    "custom/reboot"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery"
  ],
  "sway/mode": {
    "format": "{}"
  },
  "custom/logout": {
    "format": "󰈆 ",
    "on-click": "wlogout"
  },
  "custom/shutdown": {
    "format": " ",
    "on-click": "systemctl poweroff"
  },
  "custom/reboot": {
    "format": " ",
    "on-click": "systemctl reboot"
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y.%m.%d    %H:%M:%S}",
    "tooltip-format": "{calendar}"
  },
  "cpu": {
    "format": "  {usage}%"
  },
  "network": {
    "interface": "wlp0s20f3",
    "interval": 30,
    "format-wifi": "   {essid}"
  },
  "pulseaudio": {
    "format": "   {volume}%",
    "scroll-step": 5
  },
  "memory": {
    "format": "  {}%"
  },
  "battery": {
    "states": {
      "full": 99,
      "warning": 50,
      "ciritical": 10
    },
    "full-at": 100,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
