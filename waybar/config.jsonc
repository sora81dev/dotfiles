{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/logout", 
    "custom/shutdown", 
    "custom/reboot"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/music",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery"
  ],
  "sway/mode": {
    "format": "{}"
  },
  "custom/logout": {
    "format": "󰈆 ",
    "on-click": "wlogout"
  }, "custom/shutdown": {
    "format": " ",
    "on-click": "systemctl poweroff"
  },
  "custom/reboot": {
    "format": " ",
    "on-click": "systemctl reboot"
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y.%m.%d    %H:%M:%S}",
    "tooltip-format": "{calendar}"
  },
  "custom/music": {
    "exec": "/home/sora81dev/dotfiles/waybar/script/playing-music.sh 2> /tmp/music_err.log",
    "return-type": "json",
    "format": "  {text}",
    "interval": 2,
    "max-length": 45,
    "on-click": "playerctl play-pause"
  },
  "cpu": {
    "format": "  {usage}%",
    "min-length": 7,
    "max-length": 7
  },
  "network": {
    "interface": "wlp0s20f3",
    "interval": 30,
    "format-wifi": "   {essid}",
    "min-length": 20,
    "max-length": 20
  },
  "pulseaudio": {
    "format": "   {volume}%",
    "scroll-step": 5,
    "min-length": 7,
    "max-length": 7
  },
  "memory": {
    "format": "  {}%",
    "min-length": 7,
    "max-length": 7
  },
  "battery": {
    "states": {
      "warning": 30,
      "ciritical": 15
    },
    "full-at": 100,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "min-length": 7,
    "max-length": 7
  }
}
